{
  "name": "meerquest",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.8",
    "expo-audio": "~56.0.11",
    "expo-constants": "~56.0.16",
    "expo-file-system": "56.0.7",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.13",
    "expo-modules-core": "56.0.14",
    "expo-modules-jsi": "56.0.7",
    "expo-router": "~56.2.8",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "supertonic3-runtime": "file:modules/supertonic3-runtime"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "sharp": "^0.35.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.15"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "voice:setup": "python3 -m pip install -r tools/supertonic3_requirements.txt",
    "voice:supertonic3": "python3 tools/supertonic3_tts.py",
    "voice:qwen3:setup": "uv venv --python 3.12 .venv-qwen3-tts && uv pip install --python .venv-qwen3-tts/bin/python -r tools/qwen3_tts_requirements.txt",
    "voice:qwen3": "${QWEN3_TTS_PYTHON:-.venv-qwen3-tts/bin/python} tools/qwen3_tts.py",
    "model:supertonic3-manifest": "python3 tools/build_supertonic3_manifest.py"
  },
  "private": true
}
