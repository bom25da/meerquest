{
  "expo": {
    "name": "MeerQuest",
    "slug": "meerquest",
    "version": "0.0.1",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "meerquest",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.meerquest"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF3D6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-meerquest.png",
          "imageWidth": 700,
          "resizeMode": "contain",
          "backgroundColor": "#FFF3D6"
        }
      ],
      [
        "./plugins/with-responsive-splash-screen.js",
        {
          "maxSizeRatio": 0.8
        }
      ],
      "expo-audio",
      "./plugins/with-supertonic3-ios-runtime.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
